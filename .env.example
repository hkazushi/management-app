# ---------------------------------------------------------------------------
# このファイルは「変数名のテンプレート」です。実値は書かないでください。
# 実値は .env.local（gitignore 済み）にコピーして記入します。
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Supabase（公開しても安全な値。ブラウザに露出してOK）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI のキー。名前は ANTHROPIC だが、OpenRouter のキー（sk-or-...）を入れる。
# 文字起こしと議事録の生成に使う。サーバー側（Route Handler）でのみ参照する。
ANTHROPIC_API_KEY=

# --- アクセス制御（サーバー側のみ。NEXT_PUBLIC は付けない）---
# 画面で打つ PIN と、その PIN でサインインする Supabase アカウント。
APP_PIN=
APP_AUTH_EMAIL=
APP_AUTH_PASSWORD=
# 2つ目のアカウント（別 PIN → 別 Supabase アカウント。データは RLS で分かれる）
APP_PIN_2=
APP_AUTH_EMAIL_2=
APP_AUTH_PASSWORD_2=
