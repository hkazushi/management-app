# ---------------------------------------------------------------------------
# このファイルは「変数名のテンプレート」です。実値は書かないでください。
# 実値は .env.local（gitignore 済み）にコピーして記入します。
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Supabase（公開しても安全な値。ブラウザに露出してOK）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- アクセス制御（サーバー側のみ。NEXT_PUBLIC は付けない）---
# 画面で打つ PIN と、その PIN でサインインする Supabase アカウント。
APP_PIN=
APP_AUTH_EMAIL=
APP_AUTH_PASSWORD=
# 2人目（別 PIN → 別 Supabase アカウント。データは2人で共有。members に登録が必要）
APP_PIN_2=
APP_AUTH_EMAIL_2=
APP_AUTH_PASSWORD_2=
