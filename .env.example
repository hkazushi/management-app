# ---------------------------------------------------------------------------
# このファイルは「変数名のテンプレート」です。実値は書かないでください。
# 実値は .env.local（gitignore 済み）にコピーして記入します。
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Supabase（公開しても安全な値。ブラウザに露出してOK）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- アクセス制御（サーバー側のみ。NEXT_PUBLIC は付けない）---
# 画面で打つ PIN と、その PIN でサインインする Supabase アカウント。
APP_PIN=
APP_AUTH_EMAIL=
APP_AUTH_PASSWORD=
# 2人目（別 PIN → 別 Supabase アカウント。データは2人で共有。members に登録が必要）
APP_PIN_2=
APP_AUTH_EMAIL_2=
APP_AUTH_PASSWORD_2=

# --- 毎朝の通知（サーバー側のみ。NEXT_PUBLIC が付くのは公開鍵だけ）---
# 鍵の作り方: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Vercel の定期実行が /api/cron/morning を呼ぶときの合言葉（長いでたらめな文字列）
CRON_SECRET=
# Supabase のサービスキー（RLS を通らない。毎朝の通知の送信だけが使う）
SUPABASE_SERVICE_ROLE_KEY=
